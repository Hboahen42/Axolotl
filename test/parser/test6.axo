# Test 6: Comprehensive program with mixed constructs
fun factorial(n) {
    let result = 1
    let i = 1
    while (i <= n) {
        result = result * i
        i = i + 1
    }
    return result
}

let num = 5
if (num > 0) {
    let fact = factorial(num)
    print(fact)
} else {
    print("Number must be positive")
}
