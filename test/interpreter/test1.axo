# Test 1: Variable assignment, arithmetic and operator precedence
let x = 10
let y = x + 5
print(x)
print(y)
print(2 + 3 * 4)         # 14
print((2 + 3) * 4)       # 20
print(10 - 4 - 3)        # 3  (left-associative)
print(20 / 4)            # 5
print(7 / 2)             # 3.5
print(-5 + 2 * (10 - 4) / 3 ^ 2 % 7)
print(2 ^ 3 ^ 2)         # 512 (right-associative)
x = x * 2
print(x)                 # 20
